use "C" <wl_def.h>
use "C" <stdio.h>

var PMPageDataSize usize = 0

fn alloc(size usize, what addr) addr {
    p addr = malloc(size)
    if p == null { Quit(c"Out of memory at %s", what) }
    return p
}

extern "C" {
    var PMPages addr = null
    var PMPageData addr = null

    var ChunksInFile i32 = 0
    var PMSpriteStart i32 = 0
    var PMSoundStart i32 = 0

    var PMSoundInfoPagePadded bool = false

    fn PM_Startup() void {
        fname arr[13, u8] = {}
        snprintf(&fname, len(fname), c"vswap.%s", &extension)

        file handle[FILE] = fopen(&fname, c"rb")
        if file == null { CA_CannotOpen(&fname) }

        header arr[3, u16] = {}
        fread(&header, sizeof[u16], 3, file)
        ChunksInFile = zext[i32](header[0])
        PMSpriteStart = zext[i32](header[1])
        PMSoundStart = zext[i32](header[2])

        n usize = zext[usize](header[0])
        spriteStart usize = zext[usize](header[1])
        soundStart usize = zext[usize](header[2])

        pageOffsets addr = alloc((n + 1) * sizeof[u32], c"PM_Startup: pageOffsets")
        view offsets = pageOffsets[u32, ..]
        fread(pageOffsets, sizeof[u32], n, file)

        pageLengths addr = alloc(n * sizeof[u16], c"PM_Startup: pageLengths")
        view lengths = pageLengths[u16, ..]
        fread(pageLengths, sizeof[u16], n, file)

        fseek(file, 0, SEEK_END)
        fileSize i64 = ftell(file)
        offsets[n] = trunc[u32](fileSize)
        dataStart u32 = offsets[0]

        for i usize = 0; i < n; i += 1 {
            off u32 = offsets[i]
            if off != 0 && (off < dataStart || zext[i64](off) >= fileSize) {
                Quit(c"Illegal page offset for page %i: %u (filesize: %ld)", trunc[i32](i), off, fileSize)
            }
        }

        alignPadding u32 = 0
        for i usize = spriteStart; i < soundStart; i += 1 {
            if offsets[i] != 0 && (offsets[i] - dataStart + alignPadding) & 1 != 0 { alignPadding += 1 }
        }
        if (offsets[n - 1] - dataStart + alignPadding) & 1 != 0 { alignPadding += 1 }

        PMPageDataSize = bitcast[usize](fileSize - zext[i64](dataStart)) + zext[usize](alignPadding)
        PMPageData = alloc(PMPageDataSize, c"PM_Startup: PMPageData")
        PMPages = alloc((n + 1) * sizeof[addr], c"PM_Startup: PMPages")
        view data = PMPageData[u8, ..]
        view pages = PMPages[addr, ..]

        pos usize = 0
        for i usize = 0; i < n; i += 1 {
            last bool = i == n - 1
            if (i >= spriteStart && i < soundStart || last) && pos & 1 != 0 {
                data[pos] = 0
                pos += 1
                if last { PMSoundInfoPagePadded = true }
            }
            pages[i] = &data[pos]

            off u32 = offsets[i]
            if off == 0 { continue }

            size usize = zext[usize](if offsets[i + 1] == 0 { zext[u32](lengths[i]) } else { offsets[i + 1] - off })
            fseek(file, zext[i64](off), SEEK_SET)
            fread(&data[pos], 1, size, file)
            pos += size
        }
        pages[n] = &data[pos]

        free(pageLengths)
        free(pageOffsets)
        fclose(file)
    }

    fn PM_Shutdown() void {
        free(PMPages)
        free(PMPageData)
    }
}
